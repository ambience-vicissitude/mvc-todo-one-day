# Environment Variables
# Dev-only defaults. Compose works without a .env file; copy to .env to override.
# Warn: Never commit real credentials: production uses a secret manager (see README "Configuration").

# Logging and environment settings for the backend.
LOG_LEVEL=INFO
APP_ENV=development

# Uvicorn worker processes in the backend container (about one CPU core each).
WEB_CONCURRENCY=2

# PostgreSQL settings for the backend.
POSTGRES_USER=taskapp
POSTGRES_PASSWORD=dev_only_password
POSTGRES_DB=taskapp

# Per-worker DB pool. Keep workers x (pool + overflow) x replicas under Postgres max_connections.
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
