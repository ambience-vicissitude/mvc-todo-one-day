{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: initialize local SQLite",
      "type": "process",
      "command": "${workspaceFolder}\\backend\\.venv\\Scripts\\python.exe",
      "args": ["-m", "app.db.init_db"],
      "options": {
        "cwd": "${workspaceFolder}\\backend",
        "env": {
          "DATABASE_URL": "sqlite:///./local.db",
          "APP_ENV": "development",
          "LOG_LEVEL": "INFO",
          "WEB_CONCURRENCY": "1"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Backend: run local API",
      "type": "process",
      "command": "${workspaceFolder}\\backend\\.venv\\Scripts\\python.exe",
      "args": [
        "-m", "uvicorn", "app.main:app",
        "--reload", "--host", "127.0.0.1", "--port", "8000"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\backend",
        "env": {
          "DATABASE_URL": "sqlite:///./local.db",
          "APP_ENV": "development",
          "LOG_LEVEL": "INFO",
          "WEB_CONCURRENCY": "1"
        }
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Frontend: run local Vite",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}\\frontend"
      },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}